NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://readshelf-rust.vercel.app

# Admin dashboard (/admin): comma-separated emails allowed to view stats
ADMIN_EMAILS=you@example.com

# Server-only: required for admin stats (never expose to the browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth emails (your personal SMTP — use an app password, not your login password)
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=ReadShelf <you@gmail.com>

# Optional: legacy R2 read access for migration (R2_* from Cloudflare dashboard).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=readshelf
