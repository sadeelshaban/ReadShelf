NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Firebase Storage for PDFs and covers (~5 GB free on Spark plan).
# When all FIREBASE_* vars below are set, ReadShelf stores PDFs/covers on Firebase
# instead of Supabase Storage (1 GB free). Auth + database stay on Supabase.
#
# Create a Firebase project, enable Storage, then create a service account key.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# FIREBASE_STORAGE_PUBLIC_BASE_URL=https://storage.googleapis.com/your-bucket
# NEXT_PUBLIC_FIREBASE_STORAGE_PUBLIC_BASE_URL=https://storage.googleapis.com/your-bucket
