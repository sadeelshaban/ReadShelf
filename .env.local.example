NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Cloudflare R2 for long-term PDF storage (~10 GB free).
# When all R2_* vars below are set, ReadShelf stores PDFs/covers on R2
# instead of Supabase Storage (1 GB free). Auth + database stay on Supabase.
#
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret-key
# R2_BUCKET_NAME=readshelf
# R2_PUBLIC_URL=https://your-public-r2-domain.example.com
# NEXT_PUBLIC_R2_PUBLIC_URL=https://your-public-r2-domain.example.com
