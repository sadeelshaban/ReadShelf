{
  "name": "readshelf-app",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:desktop": "next build && node scripts/prepare-desktop.mjs",
    "desktop:dev": "concurrently -k \"next dev -H 127.0.0.1\" \"wait-on http://127.0.0.1:3000 && cross-env READSHELF_DEV_URL=http://127.0.0.1:3000 electron .\"",
    "desktop:pack": "npm run build:desktop && electron-builder --win nsis",
    "desktop:shortcut": "powershell -ExecutionPolicy Bypass -File ./scripts/create-desktop-shortcut.ps1",
    "setup:supabase": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-supabase.ps1",
    "setup:r2": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-r2.ps1",
    "setup:r2:auto": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-r2-auto.ps1",
    "create:r2-token": "node ./scripts/create-r2-token.mjs",
    "save:r2-keys": "powershell -ExecutionPolicy Bypass -File ./scripts/save-r2-keys.ps1",
    "test:r2": "node ./scripts/test-r2.mjs",
    "reset:data": "powershell -ExecutionPolicy Bypass -File ./scripts/reset-data.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@fontsource/noto-sans-arabic": "^5.2.10",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "next": "16.2.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.readshelf.app",
    "productName": "ReadShelf",
    "afterPack": "./scripts/after-pack.cjs",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "public/favicon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ReadShelf",
      "runAfterFinish": true
    }
  }
}
