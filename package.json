  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup:supabase": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-supabase.ps1",
    "setup:r2": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-r2.ps1",
